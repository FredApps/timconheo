{
    "name":  "tim-con-heo",
    "version": "0.5.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22.13.0"
                },
    "scripts":  {
                    "dev":  "concurrently -k \"tsx watch server/server.ts\" \"vite --host 127.0.0.1\"",
                    "build":  "vite build \u0026\u0026 tsc -p tsconfig.server.json",
                    "start":  "node dist/server/server.js",
                    "admin":  "tsx server/admin.ts",
                    "typecheck":  "tsc -p tsconfig.client.json --noEmit \u0026\u0026 tsc -p tsconfig.server.json --noEmit",
                    "test": "node --import tsx --test tests/*.test.ts",
                    "lint":  "eslint . --ignore-pattern dist --ignore-pattern android",
                    "build:android":  "vite build \u0026\u0026 cap sync android"
                },
    "dependencies":  {
                         "@capacitor-community/speech-recognition":  "7.0.1",
                         "@capacitor-community/text-to-speech":  "8.0.2",
                         "@capacitor/android":  "8.5.0",
                         "@capacitor/core":  "8.5.0",
                         "@fontsource/be-vietnam-pro":  "5.3.0",
                         "@fontsource/source-serif-4":  "5.3.0",
                         "compression":  "^1.8.1",
                         "express":  "^5.2.1",
                         "lucide-react":  "^0.468.0",
                         "react":  "19.2.8",
                         "react-dom":  "19.2.8",
                         "ts-fsrs":  "5.4.1"
                     },
    "devDependencies":  {
                            "@capacitor/cli":  "8.5.0",
                            "@tailwindcss/vite":  "4.3.3",
                            "@types/compression":  "^1.8.1",
                            "@types/express":  "^5.0.1",
                            "@types/node":  "22.19.19",
                            "@types/react":  "19.2.18",
                            "@types/react-dom":  "19.2.4",
                            "@vitejs/plugin-react":  "6.0.5",
                            "concurrently":  "^9.1.2",
                            "eslint":  "9.39.4",
                            "tailwindcss":  "4.3.3",
                            "tsx":  "^4.19.2",
                            "typescript":  "5.9.3",
                            "vite":  "8.2.0"
                        },
    "description":  "A calm Vietnamese reading app for beginners.",
    "license":  "GPL-3.0-only",
    "author":  "FredApps",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/FredApps/timconheo.git"
                   },
    "homepage":  "https://ayrien.se/heo/"
}
