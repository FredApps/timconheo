{
  "name": "tim-con-heo",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "A calm Vietnamese reading app for beginners.",
  "license": "GPL-3.0-only",
  "author": "FredApps",
  "homepage": "https://ayrien.se/heo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/FredApps/timconheo.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/heo-server.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/heo-server.js",
    "admin": "tsx server/admin.ts",
    "backup": "tsx scripts/backup-db.ts",
    "restore": "tsx scripts/restore-backup.ts",
    "precache": "tsx scripts/precache-tts.ts",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --import tsx --test \"tests/server/*.test.ts\"",
    "test:client": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "release:check": "npm run format:check && npm run typecheck && npm test && npm run test:e2e && npm run lint && npm run build && npm run audit:prod",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "build:android": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "^4.12.1",
    "concurrently": "^9.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
