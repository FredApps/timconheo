HOST=127.0.0.1
PORT=3092
HEO_DATA_DIR=C:\ProgramData\TimConHeo
HEO_SECURE_COOKIES=1
HEO_ALLOW_SIGNUPS=0
HEO_SEED_USER=fredrik
# Required only on the first start, when the database has no users.
HEO_SEED_PASSWORD=
# Set to a username to sign every request in as that account automatically,
# with no login page at all. This removes authentication for the whole
# deployment -- anyone who reaches the URL gets full read/write on that
# account. Leave empty unless you mean it. Off by default.
HEO_AUTO_LOGIN_USER=
# FPT.AI Central Vietnamese speech. Keep the key file outside the repository.
HEO_FPT_KEY_FILE=C:\ProgramData\TimConHeo\secrets\heo.fpt.key
HEO_FPT_TTS_SPEED=-1
# FPT may take several seconds to return an audio file.
HEO_FPT_POLL_TIMEOUT_MS=120000
